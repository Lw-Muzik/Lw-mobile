platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # AppAuth: flutter_appauth requires 2.0.0, google_sign_in >= 7.2 allows it
  pod 'AppAuth', '~> 2.0'

  # Local C++ DSP engine pod
  pod 'HypeDSP', :path => './HypeDSP'

  # projectM MilkDrop visualizer (prebuilt for iOS arm64)
  pod 'ProjectM', :path => './ProjectM'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Ensure C++17 for all targets that compile C++
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # flutter_foreground_task 11.x declares `pluginClass: FlutterForegroundTaskPlugin`,
      # so Flutter generates `[FlutterForegroundTaskPlugin registerWithRegistrar:]` into
      # GeneratedPluginRegistrant.m. But the ONLY definition of that class lives in
      # FlutterForegroundTaskPluginSPMBridge.swift, wrapped entirely in `#if SWIFT_PACKAGE`
      # -- a macro only Swift Package Manager defines. Under CocoaPods that file compiles
      # to nothing, the class does not exist, and the build fails with
      #   "Unknown receiver 'FlutterForegroundTaskPlugin'; did you mean
      #    'SwiftFlutterForegroundTaskPlugin'?"
      # which is the unwrapped implementation showing through.
      #
      # Defining the condition here compiles the bridge and restores the class.
      # SWIFT_PACKAGE appears in exactly ONE place in the plugin (that bridge file), so
      # this enables nothing else -- re-check that if the plugin is ever upgraded.
      #
      # Drop this when upstream ships a CocoaPods-visible class, or if this project
      # migrates to SPM (`flutter config --enable-swift-package-manager`), which defines
      # the macro itself.
      if target.name == 'flutter_foreground_task'
        conditions = config.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] || '$(inherited)'
        conditions = conditions.join(' ') if conditions.is_a?(Array)
        unless conditions.include?('SWIFT_PACKAGE')
          config.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] = "#{conditions} SWIFT_PACKAGE"
        end
      end
    end
  end

end
